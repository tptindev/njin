// Ray traced shadows (light3d::ray_traced_shadows), render3d_rt_vk.cpp.
//
// For each pixel of the pass's depth (drawn by OpenGL into a shared image),
// its world position and a normal from the neighbouring depths, then rays
// towards the sun (spread over its disc) and up to three lamps (over a sphere
// of their size): the share that reaches each, into r (sun), g, b, a (lamps).
// Few rays a pixel, moved on every frame; denoise.comp smooths the result.
#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 384, r32f) uniform readonly image2D depthImg;
layout(set = 0, binding = 385, rgba8) uniform writeonly image2D outImg;
#define RT_SCENE
#define RT_DEPTH
#include "common.glsl"

// A point of the unit disc, from two hashes (concentric would be smoother; a
// few rays and the denoiser do not need it).
vec2 disc(float a, float b) {
  float r = sqrt(a), t = 6.2831853 * b;
  return vec2(cos(t), sin(t)) * r;
}

void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  if (px.x >= int(p.size.x) || px.y >= int(p.size.y))
    return;
  float d = imageLoad(depthImg, px).r;
  if (d >= 1.0) {
    imageStore(outImg, px, vec4(1.0));
    return;
  }
  vec3 pos = world_at(px);
  vec3 n = normal_at(px, pos);
  // Off the surface by a little more far away, where a depth texel is wider.
  vec3 o = pos + n * (0.003 + 0.0008 * distance(pos, p.eye.xyz));
  int rays = max(int(p.size.z), 1);
  uint frame = uint(p.size.w);
  vec4 lit = vec4(1.0);
  if (p.lampInfo.z > 0.5) {
    vec3 l = normalize(p.sun.xyz);
    vec3 tx = normalize(cross(abs(l.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0), l));
    vec3 ty = cross(l, tx);
    float sum = 0.0;
    if (dot(n, l) <= 0.0) {
      sum = 0.0; // facing away: the lighting gives it no sun anyway
    } else {
      for (int k = 0; k < rays; k++) {
        vec2 s = disc(rnd(uvec3(px, frame * 16u + uint(k))), rnd(uvec3(px.yx, frame * 16u + uint(k) + 7u)));
        vec3 dir = normalize(l + (tx * s.x + ty * s.y) * p.sun.w);
        sum += blocked(o, dir, 10000.0) ? 0.0 : 1.0;
      }
      sum /= float(rays);
    }
    lit.r = sum;
  }
  for (int i = 0; i < 3; i++) {
    if (i >= int(p.lampInfo.x))
      break;
    float sum = 0.0;
    for (int k = 0; k < rays; k++) {
      vec3 jitter = vec3(rnd(uvec3(px, frame * 64u + uint(k * 3 + i * 17))), rnd(uvec3(px.yx, frame * 64u + uint(k * 3 + i * 17 + 1))),
                         rnd(uvec3(px + 3, frame * 64u + uint(k * 3 + i * 17 + 2)))) * 2.0 - 1.0;
      vec3 target = p.lamps[i].xyz + jitter * p.lamps[i].w;
      vec3 to = target - o;
      float len = length(to);
      sum += len < 1e-4 || !blocked(o, to / len, len - p.lamps[i].w * 0.5) ? 1.0 : 0.0;
    }
    lit[i + 1] = sum / float(rays);
  }
  imageStore(outImg, px, lit);
}
