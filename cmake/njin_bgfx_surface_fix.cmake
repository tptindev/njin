# The pinned bgfx can retain a surface without a swapchain after a minimized
# resize (SwapChainVK::update returns early for a zero-sized surface). destroy()
# must release that surface too. Keep this narrow fix reproducible on all hosts.
set(_njin_vk_cpp "${NJIN_BGFX_SOURCE_DIR}/src/renderer_vk.cpp")
set(_njin_vk_h "${NJIN_BGFX_SOURCE_DIR}/src/renderer_vk.h")
file(READ "${_njin_vk_cpp}" _njin_vk_source)
file(READ "${_njin_vk_h}" _njin_vk_header)
set(_njin_surface_old "\t\t\treleaseSwapChain();\n\t\t\treleaseSurface();\n\n\t\t\t// can't delay-delete the surface")
set(_njin_surface_new "\t\t\treleaseSwapChain();\n\t\t}\n\n\t\t// NJIN: a minimized resize can leave a surface without a swapchain.\n\t\tif (VK_NULL_HANDLE != m_surface)\n\t\t{\n\t\t\treleaseSurface();\n\n\t\t\t// can't delay-delete the surface")
if(NOT _njin_vk_source MATCHES "NJIN: a minimized resize")
  string(FIND "${_njin_vk_source}" "${_njin_surface_old}" _njin_surface_pos)
  if(_njin_surface_pos EQUAL -1)
    message(FATAL_ERROR "bgfx surface cleanup changed upstream; review njin_bgfx_surface_fix.cmake")
  endif()
  string(REPLACE "${_njin_surface_old}" "${_njin_surface_new}" _njin_vk_source "${_njin_vk_source}")
  file(WRITE "${_njin_vk_cpp}" "${_njin_vk_source}")
endif()
if(NOT _njin_vk_header MATCHES ", m_surface\\(VK_NULL_HANDLE\\)")
  set(_njin_surface_ctor ", m_vsync(false)\n\t\t\t, m_swapChain(VK_NULL_HANDLE)")
  string(FIND "${_njin_vk_header}" "${_njin_surface_ctor}" _njin_surface_pos)
  if(_njin_surface_pos EQUAL -1)
    message(FATAL_ERROR "bgfx surface constructor changed upstream; review njin_bgfx_surface_fix.cmake")
  endif()
  string(REPLACE "${_njin_surface_ctor}" ", m_vsync(false)\n\t\t\t, m_surface(VK_NULL_HANDLE)\n\t\t\t, m_swapChain(VK_NULL_HANDLE)" _njin_vk_header "${_njin_vk_header}")
  file(WRITE "${_njin_vk_h}" "${_njin_vk_header}")
endif()
