if(NOT DEFINED FRAMES)
  set(FRAMES 120)
endif()
if(NOT DEFINED SMOKE_TIMEOUT)
  set(SMOKE_TIMEOUT 120)
endif()
set(extra_arguments)
if(VALIDATION)
  list(APPEND extra_arguments --gpu-validation)
endif()
if(DEFINED EXTRA_ARGS)
  list(APPEND extra_arguments ${EXTRA_ARGS})
endif()
set(renderer_arguments)
if(DEFINED RENDERER)
  list(APPEND renderer_arguments "--renderer=${RENDERER}")
endif()
execute_process(COMMAND "${EXE}" ${renderer_arguments} "--frames=${FRAMES}" ${extra_arguments}
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT ${SMOKE_TIMEOUT})
if(DEFINED LOG)
  file(WRITE "${LOG}" "${output}\n${errors}")
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "RHI smoke failed (${result})\n${output}\n${errors}")
endif()
if("${output}\n${errors}" MATCHES "[Vv]alidation [Ee]rror|VUID-")
  message(FATAL_ERROR "GPU validation diagnostics detected\n${output}\n${errors}")
endif()
if(DEFINED EXPECTED_DRIVER)
  # bgfx's display name includes a space in "Direct3D 12".
  string(REPLACE "Direct3D12" "Direct3D 12" expected_driver "${EXPECTED_DRIVER}")
  string(FIND "${output}\n${errors}" "Njin bgfx renderer: ${expected_driver}" driver_position)
  if(driver_position EQUAL -1)
    message(FATAL_ERROR "Default backend did not initialize ${EXPECTED_DRIVER}\n${output}\n${errors}")
  endif()
endif()
