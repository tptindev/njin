# Shader lớn không được chiếm stack của SDLThread (Android thường chỉ có 1 MiB).
# Giữ các buffer tới hết ShaderGL::create; glShaderSource sao chép nội dung.
set(_njin_gl_path "${NJIN_BGFX_SOURCE_DIR}/src/renderer_gl.cpp")
file(READ "${_njin_gl_path}" _njin_gl)
if(NOT _njin_gl MATCHES "njinShaderTemp")
  set(_old "void ShaderGL::create(const Memory* _mem)\n\t{")
  set(_new "${_old}\n\t\tbx::MemoryBlock njinShaderTemp(g_allocator), njinConstantTemp(g_allocator), njinNdcTemp(g_allocator), njinAngleTemp(g_allocator);")
  string(FIND "${_njin_gl}" "${_old}" _at)
  if(_at EQUAL -1)
    message(FATAL_ERROR "bgfx ShaderGL::create changed; review njin_bgfx_shader_stack_fix.cmake")
  endif()
  string(REPLACE "${_old}" "${_new}" _njin_gl "${_njin_gl}")
  foreach(_pair IN ITEMS "temp|tempLen|njinShaderTemp" "constTemp|constTempLen|njinConstantTemp" "ndcTemp|ndcTempLen|njinNdcTemp" "source|len|njinAngleTemp")
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _size)
    list(GET _parts 2 _owner)
    set(_old "${_name} = (char*)BX_STACK_ALLOC(${_size});")
    string(FIND "${_njin_gl}" "${_old}" _at)
    if(_at EQUAL -1)
      message(FATAL_ERROR "bgfx shader scratch buffer changed: ${_name}; review njin_bgfx_shader_stack_fix.cmake")
    endif()
    string(REPLACE "${_old}" "${_name} = (char*)${_owner}.more(${_size});" _njin_gl "${_njin_gl}")
  endforeach()
  file(WRITE "${_njin_gl_path}" "${_njin_gl}")
endif()
