# Build and package a copy of the public template OUTSIDE the engine checkout.
# The engine must already be built. TEST_ROOT must be a fresh external folder.
cmake_minimum_required(VERSION 3.28)
foreach(required NJIN_ROOT NJIN_PREBUILT TEST_ROOT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Pass -D${required}=<path>")
  endif()
endforeach()
file(REAL_PATH "${NJIN_ROOT}" NJIN_ROOT)
cmake_path(ABSOLUTE_PATH TEST_ROOT NORMALIZE)
cmake_path(IS_PREFIX NJIN_ROOT "${TEST_ROOT}" NORMALIZE inside_engine)
if(inside_engine OR EXISTS "${TEST_ROOT}")
  message(FATAL_ERROR "TEST_ROOT must be a fresh folder outside NJIN_ROOT: ${TEST_ROOT}")
endif()
if(NOT DEFINED CONFIG)
  set(CONFIG Release)
endif()
if(NOT DEFINED GENERATOR)
  file(STRINGS "${NJIN_PREBUILT}/CMakeCache.txt" generator_line
    REGEX "^CMAKE_GENERATOR:INTERNAL=")
  string(REGEX REPLACE "^CMAKE_GENERATOR:INTERNAL=" "" GENERATOR "${generator_line}")
  if(NOT GENERATOR)
    message(FATAL_ERROR "Cannot determine the engine generator; pass -DGENERATOR=<generator>")
  endif()
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
file(COPY "${NJIN_ROOT}/templates/game/" DESTINATION "${TEST_ROOT}")
set(configure_args -G "${GENERATOR}"
  "-DNJIN_ROOT=${NJIN_ROOT}" "-DNJIN_PREBUILT=${NJIN_PREBUILT}")
if(NOT GENERATOR MATCHES "Visual Studio|Xcode|Multi-Config")
  list(APPEND configure_args "-DCMAKE_BUILD_TYPE=${CONFIG}")
endif()
if(DEFINED CXX_COMPILER)
  list(APPEND configure_args "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}" -B "${TEST_ROOT}/build"
  ${configure_args} COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_ROOT}/build"
  --config "${CONFIG}" --target my_game_dist COMMAND_ERROR_IS_FATAL ANY)
set(dist "${TEST_ROOT}/build/dist")
if(NOT EXISTS "${dist}/my_game/assets/README.txt" OR
   NOT EXISTS "${dist}/my_game-0.1.0.zip")
  message(FATAL_ERROR "Standalone game packaging did not produce the assets and archive")
endif()
message(STATUS "Standalone game built and packaged in ${TEST_ROOT}")
